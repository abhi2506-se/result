// ACEM College Result Portal - Prisma Schema
// Production-ready PostgreSQL Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// ENUMS
// ================================

enum Role {
  SUPER_ADMIN
  HOD
  TEACHER
  STUDENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  SENT_BACK
  REJECTED
}

enum ResultStatus {
  PASS
  FAIL
  BACKLOG
  NOT_PUBLISHED
}

enum NotificationType {
  APPROVAL
  REJECTION
  SENT_BACK
  RESULT_PUBLISHED
  MARKS_UPDATED
  SYSTEM
}

enum SemesterType {
  ODD
  EVEN
}

enum SubjectType {
  THEORY
  PRACTICAL
  ELECTIVE
}

enum ExamType {
  SESSIONAL
  PUT
  INTERNAL
}

enum LogAction {
  LOGIN
  LOGOUT
  REGISTER
  APPROVE_STUDENT
  REJECT_STUDENT
  PUBLISH_RESULT
  UPDATE_MARKS
  CREATE_DEPARTMENT
  ASSIGN_HOD
  ASSIGN_TEACHER
}

// ================================
// CORE USER MODEL
// ================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String
  role            Role      @default(STUDENT)
  avatar          String?
  phone           String?
  emailVerified   Boolean   @default(false)
  verifyToken     String?   @unique
  resetToken      String?   @unique
  resetTokenExpiry DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  studentProfile  Student?
  teacherProfile  Teacher?
  hodProfile      HOD?
  notifications   Notification[]
  activityLogs    ActivityLog[]
  sessions        Session[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ================================
// DEPARTMENT & HIERARCHY
// ================================

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  hods        HOD[]
  teachers    Teacher[]
  students    Student[]
  subjects    Subject[]
  batches     Batch[]

  @@index([code])
}

model HOD {
  id           String   @id @default(cuid())
  userId       String   @unique
  departmentId String?
  employeeId   String   @unique
  designation  String   @default("Head of Department")
  joinedAt     DateTime @default(now())
  isActive     Boolean  @default(true)

  // Relations
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id])
  approvals    ApprovalRequest[]
  resultPublishes ResultPublish[]

  @@index([userId])
  @@index([departmentId])
}

model Teacher {
  id           String   @id @default(cuid())
  userId       String   @unique
  departmentId String?
  employeeId   String   @unique
  qualification String?
  specialization String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Relations
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department        Department? @relation(fields: [departmentId], references: [id])
  subjectAssignments SubjectAssignment[]
  marksEntries      MarksEntry[]

  @@index([userId])
  @@index([departmentId])
}

// ================================
// ACADEMIC STRUCTURE
// ================================

model Batch {
  id           String   @id @default(cuid())
  name         String
  year         Int
  departmentId String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Relations
  department Department @relation(fields: [departmentId], references: [id])
  students   Student[]
  sessions   AcademicSession[]

  @@unique([name, departmentId])
  @@index([departmentId])
}

model AcademicSession {
  id        String   @id @default(cuid())
  name      String
  startYear Int
  endYear   Int
  isActive  Boolean  @default(false)
  batchId   String
  createdAt DateTime @default(now())

  // Relations
  batch     Batch      @relation(fields: [batchId], references: [id])
  results   Result[]

  @@index([batchId])
}

model Subject {
  id           String      @id @default(cuid())
  name         String
  code         String      @unique
  departmentId String
  semester     Int
  credits      Int         @default(4)
  type         SubjectType @default(THEORY)
  maxTheory    Int         @default(100)
  maxPractical Int         @default(0)
  maxInternal  Int         @default(30)
  maxAttendance Int        @default(10)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  // Relations
  department         Department @relation(fields: [departmentId], references: [id])
  subjectAssignments SubjectAssignment[]
  marks              Marks[]

  @@index([departmentId])
  @@index([semester])
}

model SubjectAssignment {
  id        String   @id @default(cuid())
  teacherId String
  subjectId String
  batchId   String?
  semester  Int
  session   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relations
  teacher Teacher @relation(fields: [teacherId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([teacherId, subjectId, semester, session])
  @@index([teacherId])
  @@index([subjectId])
}

// ================================
// STUDENT MODEL
// ================================

model Student {
  id               String         @id @default(cuid())
  userId           String         @unique
  enrollmentNumber String         @unique
  rollNumber       String         @unique
  departmentId     String
  batchId          String?
  semester         Int
  currentSemester  Int            @default(1)
  approvalStatus   ApprovalStatus @default(PENDING)
  approvalComment  String?
  profilePhoto     String?
  isActive         Boolean        @default(true)
  submittedAt      DateTime       @default(now())
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department       Department       @relation(fields: [departmentId], references: [id])
  batch            Batch?           @relation(fields: [batchId], references: [id])
  approvalRequests ApprovalRequest[]
  results          Result[]

  @@index([enrollmentNumber])
  @@index([rollNumber])
  @@index([departmentId])
  @@index([approvalStatus])
}

model ApprovalRequest {
  id         String         @id @default(cuid())
  studentId  String
  hodId      String?
  status     ApprovalStatus @default(PENDING)
  comment    String?
  reviewedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hod     HOD?    @relation(fields: [hodId], references: [id])

  @@index([studentId])
  @@index([hodId])
  @@index([status])
}

// ================================
// RESULT MANAGEMENT
// ================================

model Result {
  id          String       @id @default(cuid())
  studentId   String
  sessionId   String
  semester    Int
  examType    ExamType     @default(SESSIONAL)
  status      ResultStatus @default(NOT_PUBLISHED)
  isPublished Boolean      @default(false)
  publishedAt DateTime?
  sgpa        Float?
  percentage  Float?
  totalMarks  Int          @default(0)
  maxMarks    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  student  Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session  AcademicSession @relation(fields: [sessionId], references: [id])
  marks    Marks[]
  publishes ResultPublish[]

  @@unique([studentId, sessionId, semester, examType])
  @@index([studentId])
  @@index([sessionId])
  @@index([isPublished])
}

model Marks {
  id            String   @id @default(cuid())
  resultId      String
  subjectId     String
  theoryMarks   Float?   @default(0)
  practicalMarks Float?  @default(0)
  internalMarks Float?   @default(0)
  attendanceMarks Float? @default(0)
  totalMarks    Float?   @default(0)
  grade         String?
  gradePoints   Float?
  isPassed      Boolean  @default(false)
  isBacklog     Boolean  @default(false)
  enteredById   String?
  isDraft       Boolean  @default(true)
  submittedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  result    Result  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id])
  enteredBy MarksEntry[]

  @@unique([resultId, subjectId])
  @@index([resultId])
  @@index([subjectId])
}

model MarksEntry {
  id        String   @id @default(cuid())
  marksId   String
  teacherId String
  action    String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  // Relations
  marks   Marks   @relation(fields: [marksId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([marksId])
  @@index([teacherId])
}

model ResultPublish {
  id          String   @id @default(cuid())
  resultId    String
  hodId       String
  publishedAt DateTime @default(now())
  note        String?

  // Relations
  result Result @relation(fields: [resultId], references: [id])
  hod    HOD    @relation(fields: [hodId], references: [id])

  @@index([resultId])
  @@index([hodId])
}

// ================================
// NOTIFICATIONS
// ================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ================================
// ACTIVITY LOGS
// ================================

model ActivityLog {
  id        String    @id @default(cuid())
  userId    String
  action    LogAction
  target    String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
